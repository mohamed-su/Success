@RestController
@RequestMapping("/api/secretary")
@CrossOrigin(origins = {"http://localhost:3000", "http://localhost:5173"})
public class SecretaryController {

    private static final Logger logger = LoggerFactory.getLogger(SecretaryController.class);
    private static final ObjectMapper objectMapper = new ObjectMapper();

    @Autowired
    private ProtocolSubmissionRepository repository;

    @GetMapping("/protocols")
    public ResponseEntity<?> getProtocolsForSecretary() {
        try {
            List<ProtocolSubmission> allProtocols = repository.findAllByOrderByIdAsc();
            
            Map<String, Object> response = new HashMap<>();
            response.put("success", true);
            response.put("protocols", allProtocols);
            response.put("count", allProtocols.size());
            return ResponseEntity.ok(response);
        } catch (Exception e) {
            return ResponseEntity.status(500).body(Map.of(
                "success", false,
                "error", e.getMessage()
            ));
        }
    }

    @GetMapping("/protocols/pending")
    public ResponseEntity<?> getPendingProtocols() {
        try {
            List<ProtocolSubmission> protocols = repository.findByStatusOrderByIdAsc("SUBMITTED");
            Map<String, Object> response = new HashMap<>();
            response.put("success", true);
            response.put("protocols", protocols);
            response.put("count", protocols.size());
            return ResponseEntity.ok(response);
        } catch (Exception e) {
            return ResponseEntity.status(500).body(Map.of(
                "success", false,
                "error", e.getMessage()
            ));
        }
    }

    @GetMapping("/protocols/{id}")
    public ResponseEntity<?> getProtocolDetails(@PathVariable Long id) {
        try {
            var protocol = repository.findById(id);
            if (protocol.isEmpty()) {
                return ResponseEntity.status(404).body(Map.of(
                    "success", false,
                    "error", "Protocole non trouvé"
                ));
            }
            
            return ResponseEntity.ok(Map.of(
                "success", true,
                "protocol", protocol.get()
            ));
        } catch (Exception e) {
            return ResponseEntity.status(500).body(Map.of(
                "success", false,
                "error", e.getMessage()
            ));
        }
    }

    @PostMapping("/protocols/{id}/verify")
    public ResponseEntity<?> verifyProtocol(@PathVariable Long id, @RequestBody Map<String, String> request) {
        try {
            var protocol = repository.findById(id);
            if (protocol.isEmpty()) {
                return ResponseEntity.notFound().build();
            }

            ProtocolSubmission p = protocol.get();
            String action = request.get("action");
            String comments = request.get("comments");

            if ("confirm".equals(action)) {
                p.setStatus("VERIFIED");
                p.setVerifiedAt(LocalDateTime.now());
                p.setVerificationComments(comments);
            } else if ("reject".equals(action)) {
                p.setStatus("VERIFICATION_REJECTED");
                p.setVerifiedAt(LocalDateTime.now());
                p.setVerificationComments(comments);
            }

            repository.save(p);

            String message = "confirm".equals(action) 
                ? "Protocole marqué comme CONFORME. Le chercheur sera notifié."
                : "Protocole marqué comme NON CONFORME. Le chercheur devra reprendre son dossier.";

            return ResponseEntity.ok(Map.of(
                "success", true,
                "message", message,
                "status", p.getStatus()
            ));
        } catch (Exception e) {
            return ResponseEntity.status(500).body(Map.of(
                "success", false,
                "error", e.getMessage()
            ));
        }
    }

    @GetMapping("/protocols/verified")
    public ResponseEntity<?> getVerifiedProtocols() {
        try {
            List<ProtocolSubmission> protocols = repository.findByStatusOrderByIdAsc("VERIFIED");
            Map<String, Object> response = new HashMap<>();
            response.put("success", true);
            response.put("protocols", protocols);
            response.put("count", protocols.size());
            return ResponseEntity.ok(response);
        } catch (Exception e) {
            return ResponseEntity.status(500).body(Map.of(
                "success", false,
                "error", e.getMessage()
            ));
        }
    }

    @GetMapping("/protocols/rejected")
    public ResponseEntity<?> getRejectedProtocols() {
        try {
            List<ProtocolSubmission> protocols = repository.findByStatusOrderByIdAsc("VERIFICATION_REJECTED");
            Map<String, Object> response = new HashMap<>();
            response.put("success", true);
            response.put("protocols", protocols);
            response.put("count", protocols.size());
            return ResponseEntity.ok(response);
        } catch (Exception e) {
            return ResponseEntity.status(500).body(Map.of(
                "success", false,
                "error", e.getMessage()
            ));
        }
    }

    @GetMapping("/protocols/all")
    public ResponseEntity<?> getAllProtocols() {
        try {
            List<ProtocolSubmission> protocols = repository.findAllByOrderByIdAsc();
            Map<String, Object> response = new HashMap<>();
            response.put("success", true);
            response.put("protocols", protocols);
            response.put("count", protocols.size());
            
            // Statistiques détaillées avec tous les statuts
            Map<String, Object> stats = new HashMap<>();
            stats.put("total", protocols.size());
            stats.put("submitted", protocols.stream().filter(p -> "SUBMITTED".equals(p.getStatus())).count());
            stats.put("verified", protocols.stream().filter(p -> "VERIFIED".equals(p.getStatus())).count());
            stats.put("rejected", protocols.stream().filter(p -> "VERIFICATION_REJECTED".equals(p.getStatus())).count());
            stats.put("assignedToMember", protocols.stream().filter(p -> "ASSIGNED_TO_MEMBER".equals(p.getStatus())).count());
            stats.put("committeeApproved", protocols.stream().filter(p -> "COMMITTEE_APPROVED".equals(p.getStatus())).count());
            stats.put("committeeRejected", protocols.stream().filter(p -> "COMMITTEE_REJECTED".equals(p.getStatus())).count());
            stats.put("totalParticipants", protocols.stream().mapToInt(ProtocolSubmission::getParticipants).sum());
            stats.put("averageDuration", protocols.stream().mapToInt(ProtocolSubmission::getDuration).average().orElse(0));
            
            // Statistiques consolidées pour le frontend
            stats.put("pendingValidation", protocols.stream().filter(p -> "SUBMITTED".equals(p.getStatus())).count());
            stats.put("validated", protocols.stream().filter(p -> "VERIFIED".equals(p.getStatus()) || "COMMITTEE_APPROVED".equals(p.getStatus())).count());
            stats.put("rejectedTotal", protocols.stream().filter(p -> "VERIFICATION_REJECTED".equals(p.getStatus()) || "COMMITTEE_REJECTED".equals(p.getStatus())).count());
            stats.put("inReview", protocols.stream().filter(p -> "ASSIGNED_TO_MEMBER".equals(p.getStatus())).count());
            
            response.put("statistics", stats);
            return ResponseEntity.ok(response);
        } catch (Exception e) {
            return ResponseEntity.status(500).body(Map.of(
                "success", false,
                "error", e.getMessage()
            ));
        }
    }

    @GetMapping("/protocols/export-list")
    public ResponseEntity<?> exportProtocolsList(@RequestParam(defaultValue = "all") String status) {
        try {
            List<ProtocolSubmission> protocols;
            String title;
            
            switch (status.toLowerCase()) {
                case "pending":
                    protocols = repository.findByStatusOrderByIdAsc("SUBMITTED");
                    title = "Liste des Protocoles en Attente";
                    break;
                case "verified":
                    protocols = repository.findByStatusOrderByIdAsc("VERIFIED");
                    title = "Liste des Protocoles Conformes";
                    break;
                case "rejected":
                    protocols = repository.findByStatusOrderByIdAsc("VERIFICATION_REJECTED");
                    title = "Liste des Protocoles Refusés";
                    break;
                default:
                    protocols = repository.findAllByOrderByIdAsc();
                    title = "Liste de Tous les Protocoles";
            }

            Map<String, Object> response = new HashMap<>();
            response.put("success", true);
            response.put("title", title);
            response.put("protocols", protocols);
            response.put("count", protocols.size());
            response.put("generatedAt", LocalDateTime.now().format(DateTimeFormatter.ISO_LOCAL_DATE_TIME));
            
            return ResponseEntity.ok(response);
        } catch (Exception e) {
            return ResponseEntity.status(500).body(Map.of(
                "success", false,
                "error", e.getMessage()
            ));
        }
    }
    @GetMapping("/protocols/export-pdf")
    public ResponseEntity<byte[]> exportProtocolsToPdf(
            @RequestParam(defaultValue = "all") String status,
            @RequestParam(required = false) String month,
            @RequestParam(required = false) String year) {
        try {
            List<ProtocolSubmission> protocols;
            String title;
            
            switch (status.toLowerCase()) {
                case "pending":
                    protocols = repository.findByStatusOrderByIdAsc("SUBMITTED");
                    title = "Liste des Protocoles en Attente";
                    break;
                case "verified":
                    protocols = repository.findByStatusOrderByIdAsc("VERIFIED");
                    title = "Liste des Protocoles Conformes";
                    break;
                case "rejected":
                    protocols = repository.findByStatusOrderByIdAsc("VERIFICATION_REJECTED");
                    title = "Liste des Protocoles Refus\u00e9s";
                    break;
                default:
                    protocols = repository.findAllByOrderByIdAsc();
                    title = "Liste de Tous les Protocoles";
            }
            
            // Filtrage par mois/année
            if (year != null && !year.isEmpty()) {
                int yearInt = Integer.parseInt(year);
                protocols = protocols.stream()
                    .filter(p -> p.getSubmittedAt().getYear() == yearInt)
                    .collect(java.util.stream.Collectors.toList());
                title += " - Année " + year;
                
                if (month != null && !month.isEmpty()) {
                    int monthInt = Integer.parseInt(month);
                    protocols = protocols.stream()
                        .filter(p -> p.getSubmittedAt().getMonthValue() == monthInt)
                        .collect(java.util.stream.Collectors.toList());
                    title += " - Mois " + String.format("%02d", monthInt);
                }
            }

            ByteArrayOutputStream baos = new ByteArrayOutputStream();
            PdfWriter writer = new PdfWriter(baos);
            PdfDocument pdf = new PdfDocument(writer);
            Document document = new Document(pdf);

            // En-tête sans logo pour éviter les erreurs
            document.add(new Paragraph("RÉPUBLIQUE DU BURKINA FASO")
                .setTextAlignment(TextAlignment.CENTER)
                .setFontSize(16)
                .setBold());
            document.add(new Paragraph("Unité - Travail - Progrès")
                .setTextAlignment(TextAlignment.CENTER)
                .setFontSize(10)
                .setItalic());
            
            document.add(new Paragraph(" "));
            
            document.add(new Paragraph("COMITÉ D'ÉTHIQUE DE LA RECHERCHE")
                .setTextAlignment(TextAlignment.CENTER)
                .setFontSize(18)
                .setBold()
                .setFontColor(new DeviceRgb(0, 51, 102)));
            
            document.add(new Paragraph(title)
                .setTextAlignment(TextAlignment.CENTER)
                .setFontSize(14)
                .setBold()
                .setFontColor(new DeviceRgb(204, 0, 0)));
            
            document.add(new Paragraph("Généré le: " + LocalDateTime.now().format(DateTimeFormatter.ofPattern("dd/MM/yyyy à HH:mm")))
                .setTextAlignment(TextAlignment.CENTER)
                .setFontSize(10));
            
            // Ligne de séparation
            document.add(new Paragraph("═══════════════════════════════════════════════════════════════════")
                .setTextAlignment(TextAlignment.CENTER)
                .setFontSize(10)
                .setFontColor(new DeviceRgb(0, 51, 102)));
            
            document.add(new Paragraph(" "));

            // Tableau amélioré
            Table table = new Table(UnitValue.createPercentArray(new float[]{8, 30, 20, 20, 8, 8, 12}));
            table.setWidth(UnitValue.createPercentValue(100));
            table.setMarginTop(10);
            table.setMarginBottom(10);
            
            // En-têtes avec style
            String[] headerTexts = {"Réf.", "THÈME DE RECHERCHE", "CHERCHEUR PRINCIPAL", "INSTITUTION", "PART.", "DURÉE", "STATUT"};
            
            for (String headerText : headerTexts) {
                Cell headerCell = new Cell().add(new Paragraph(headerText)
                    .setBold()
                    .setFontSize(9)
                    .setTextAlignment(TextAlignment.CENTER)
                    .setFontColor(ColorConstants.WHITE))
                    .setBackgroundColor(new DeviceRgb(0, 51, 102))
                    .setPadding(8);
                table.addHeaderCell(headerCell);
            }

            // Données avec formatage professionnel et checklist
            int rowIndex = 0;
            for (ProtocolSubmission protocol : protocols) {
                DeviceRgb rowColor = rowIndex % 2 == 0 ? new DeviceRgb(248, 249, 250) : new DeviceRgb(255, 255, 255);
                
                // Vérification de la checklist - mise en rouge si incomplète
                boolean isChecklistComplete = checkProtocolCompleteness(protocol);
                if (!isChecklistComplete) {
                    rowColor = new DeviceRgb(255, 235, 235); // Rouge clair pour les lignes incomplètes
                }
                
                // Référence
                Cell refCell = new Cell().add(new Paragraph("PROT-" + protocol.getId())
                    .setFontSize(8).setBold())
                    .setBackgroundColor(rowColor)
                    .setPadding(6)
                    .setTextAlignment(TextAlignment.CENTER);
                
                if (!isChecklistComplete) {
                    refCell.add(new Paragraph("⚠️")
                        .setFontSize(6)
                        .setFontColor(new DeviceRgb(220, 53, 69)));
                }
                table.addCell(refCell);
                
                // Thème de recherche (titre)
                Cell titleCell = new Cell().add(new Paragraph(protocol.getTitle())
                    .setFontSize(8))
                    .setBackgroundColor(rowColor)
                    .setPadding(6);
                
                if (!isChecklistComplete) {
                    titleCell.add(new Paragraph("DOSSIER INCOMPLET")
                        .setFontSize(6)
                        .setBold()
                        .setFontColor(new DeviceRgb(220, 53, 69)));
                }
                table.addCell(titleCell);
                
                // Chercheur principal
                table.addCell(new Cell().add(new Paragraph(protocol.getPrincipalInvestigator())
                    .setFontSize(8))
                    .setBackgroundColor(rowColor)
                    .setPadding(6));
                
                // Institution
                table.addCell(new Cell().add(new Paragraph(protocol.getInstitution())
                    .setFontSize(8))
                    .setBackgroundColor(rowColor)
                    .setPadding(6));
                
                // Participants
                table.addCell(new Cell().add(new Paragraph(String.valueOf(protocol.getParticipants()))
                    .setFontSize(8))
                    .setBackgroundColor(rowColor)
                    .setPadding(6)
                    .setTextAlignment(TextAlignment.CENTER));
                
                // Durée
                table.addCell(new Cell().add(new Paragraph(protocol.getDuration() + "m")
                    .setFontSize(8))
                    .setBackgroundColor(rowColor)
                    .setPadding(6)
                    .setTextAlignment(TextAlignment.CENTER));
                
                // Statut avec couleur
                String statusText;
                DeviceRgb statusColor;
                switch (protocol.getStatus()) {
                    case "SUBMITTED" -> { statusText = "En attente"; statusColor = new DeviceRgb(0, 123, 255); }
                    case "VERIFIED" -> { statusText = "Conforme"; statusColor = new DeviceRgb(40, 167, 69); }
                    case "VERIFICATION_REJECTED" -> { statusText = "Rejeté"; statusColor = new DeviceRgb(220, 53, 69); }
                    default -> { statusText = protocol.getStatus(); statusColor = new DeviceRgb(108, 117, 125); }
                }
                
                table.addCell(new Cell().add(new Paragraph(statusText)
                    .setFontSize(8)
                    .setBold()
                    .setFontColor(ColorConstants.WHITE))
                    .setBackgroundColor(statusColor)
                    .setPadding(6)
                    .setTextAlignment(TextAlignment.CENTER));
                
                rowIndex++;
            }

            document.add(table);
            
            // Section des protocoles incomplets
            long incomplets = protocols.stream().filter(p -> !checkProtocolCompleteness(p)).count();
            if (incomplets > 0) {
                document.add(new Paragraph(" "));
                document.add(new Paragraph("⚠️ PROTOCOLES INCOMPLETS")
                    .setBold()
                    .setFontSize(12)
                    .setFontColor(new DeviceRgb(220, 53, 69)));
                
                for (ProtocolSubmission protocol : protocols) {
                    if (!checkProtocolCompleteness(protocol)) {
                        document.add(new Paragraph("PROT-" + protocol.getId() + " - " + protocol.getTitle())
                            .setFontSize(10)
                            .setBold());
                        
                        java.util.List<String> missing = getMissingItems(protocol);
                        for (String item : missing) {
                            document.add(new Paragraph("  • Manquant: " + item)
                                .setFontSize(9)
                                .setFontColor(new DeviceRgb(220, 53, 69)));
                        }
                        document.add(new Paragraph(" "));
                    }
                }
            }
            
            // Résumé statistique
            document.add(new Paragraph(" "));
            document.add(new Paragraph("RÉSUMÉ STATISTIQUE").setBold().setFontSize(12));
            
            long soumis = protocols.stream().filter(p -> "SUBMITTED".equals(p.getStatus())).count();
            long conformes = protocols.stream().filter(p -> "VERIFIED".equals(p.getStatus()) || "COMMITTEE_APPROVED".equals(p.getStatus())).count();
            long rejetes = protocols.stream().filter(p -> "VERIFICATION_REJECTED".equals(p.getStatus()) || "COMMITTEE_REJECTED".equals(p.getStatus())).count();
            long enEvaluation = protocols.stream().filter(p -> "ASSIGNED_TO_MEMBER".equals(p.getStatus())).count();
            int totalParticipants = protocols.stream().mapToInt(ProtocolSubmission::getParticipants).sum();
            
            document.add(new Paragraph("• Total des protocoles: " + protocols.size()));
            document.add(new Paragraph("• Protocoles soumis: " + soumis));
            document.add(new Paragraph("• Protocoles conformes: " + conformes));
            document.add(new Paragraph("• Protocoles en évaluation: " + enEvaluation));
            document.add(new Paragraph("• Protocoles non conformes: " + rejetes));
            document.add(new Paragraph("• Protocoles incomplets: " + incomplets)
                .setFontColor(incomplets > 0 ? new DeviceRgb(220, 53, 69) : new DeviceRgb(0, 0, 0)));
            document.add(new Paragraph("• Total participants impliqués: " + totalParticipants));
            
            document.add(new Paragraph(" "));
            
            // Pied de page officiel
            document.add(new Paragraph("═══════════════════════════════════════════════════════════════════")
                .setTextAlignment(TextAlignment.CENTER)
                .setFontSize(10)
                .setFontColor(new DeviceRgb(0, 51, 102)));
            
            document.add(new Paragraph("Document officiel généré automatiquement")
                .setTextAlignment(TextAlignment.CENTER)
                .setFontSize(9)
                .setItalic()
                .setFontColor(new DeviceRgb(108, 117, 125)));
            
            document.add(new Paragraph("Comité d'Éthique de la Recherche - Burkina Faso")
                .setTextAlignment(TextAlignment.CENTER)
                .setFontSize(8)
                .setBold()
                .setFontColor(new DeviceRgb(0, 51, 102)));

            document.close();

            HttpHeaders headers = new HttpHeaders();
            headers.setContentType(MediaType.APPLICATION_PDF);
            headers.setContentDispositionFormData("attachment", "liste-protocoles-" + status + ".pdf");

            return ResponseEntity.ok()
                .headers(headers)
                .body(baos.toByteArray());

        } catch (NumberFormatException e) {
            logger.error("Erreur de format numérique lors de la génération du PDF: {}", e.getMessage());
            return createErrorResponse(400, "FORMAT_ERROR", "Paramètres numériques invalides");
        } catch (IllegalArgumentException e) {
            logger.error("Paramètres invalides: {}", e.getMessage());
            return createErrorResponse(400, "INVALID_PARAMS", "Paramètres de requête invalides");
        } catch (Exception e) {
            logger.error("Erreur inattendue lors de la génération du PDF", e);
            return createErrorResponse(500, "INTERNAL_ERROR", "Erreur interne du serveur");
        }
    }

    private ResponseEntity<byte[]> createErrorResponse(int status, String errorCode, String message) {
        try {
            Map<String, Object> errorResponse = Map.of(
                "success", false,
                "error", Map.of(
                    "code", errorCode,
                    "message", message,
                    "timestamp", LocalDateTime.now().format(DateTimeFormatter.ISO_LOCAL_DATE_TIME)
                )
            );
            
            HttpHeaders headers = new HttpHeaders();
            headers.setContentType(MediaType.APPLICATION_JSON);
            
            return ResponseEntity.status(status)
                .headers(headers)
                .body(objectMapper.writeValueAsBytes(errorResponse));
        } catch (Exception e) {
            logger.error("Erreur lors de la création de la réponse d'erreur", e);
            HttpHeaders headers = new HttpHeaders();
            headers.setContentType(MediaType.TEXT_PLAIN);
            return ResponseEntity.status(500)
                .headers(headers)
                .body("Erreur critique du serveur".getBytes());
        }
    }

    private boolean checkProtocolCompleteness(ProtocolSubmission protocol) {
        // Vérification de la checklist obligatoire
        boolean hasTitle = protocol.getTitle() != null && !protocol.getTitle().trim().isEmpty();
        boolean hasDescription = protocol.getDescription() != null && !protocol.getDescription().trim().isEmpty();
        boolean hasPrincipalInvestigator = protocol.getPrincipalInvestigator() != null && !protocol.getPrincipalInvestigator().trim().isEmpty();
        boolean hasInstitution = protocol.getInstitution() != null && !protocol.getInstitution().trim().isEmpty();
        boolean hasParticipants = protocol.getParticipants() != null && protocol.getParticipants() > 0;
        boolean hasDuration = protocol.getDuration() != null && protocol.getDuration() > 0;
        boolean hasEthicalConsiderations = protocol.getEthicalConsiderations() != null && !protocol.getEthicalConsiderations().trim().isEmpty();
        
        // Vérification des fichiers obligatoires
        boolean hasProtocolFile = protocol.getProtocolFileName() != null && !protocol.getProtocolFileName().trim().isEmpty();
        boolean hasConsentForm = protocol.getConsentFormFileName() != null && !protocol.getConsentFormFileName().trim().isEmpty();
        boolean hasCvFiles = protocol.getCvFilesNames() != null && !protocol.getCvFilesNames().trim().isEmpty();
        boolean hasPaymentReceipt = protocol.getPaymentReceiptFileName() != null && !protocol.getPaymentReceiptFileName().trim().isEmpty();
        
        // Nouveaux fichiers obligatoires
        boolean hasPresidentLetter = protocol.getPresidentLetterFileName() != null && !protocol.getPresidentLetterFileName().trim().isEmpty();
        boolean hasInformationNotice = protocol.getInformationNoticeFileName() != null && !protocol.getInformationNoticeFileName().trim().isEmpty();
        boolean hasInformedConsent = protocol.getInformedConsentFileName() != null && !protocol.getInformedConsentFileName().trim().isEmpty();
        boolean hasChronogram = protocol.getChronogramFileName() != null && !protocol.getChronogramFileName().trim().isEmpty();
        boolean hasDetailedBudget = protocol.getDetailedBudgetFileName() != null && !protocol.getDetailedBudgetFileName().trim().isEmpty();
        
        return hasTitle && hasDescription && hasPrincipalInvestigator && hasInstitution && 
               hasParticipants && hasDuration && hasEthicalConsiderations && 
               hasProtocolFile && hasConsentForm && hasCvFiles && hasPaymentReceipt &&
               hasPresidentLetter && hasInformationNotice && hasInformedConsent && hasChronogram && hasDetailedBudget;
    }

    @PostMapping("/protocols/{id}/checklist")
    public ResponseEntity<?> updateChecklist(@PathVariable Long id, @RequestBody Map<String, Object> checklistData) {
        try {
            java.util.Optional<ProtocolSubmission> protocolOpt = repository.findById(id);
            if (protocolOpt.isEmpty()) {
                return ResponseEntity.status(404).body(Map.of(
                    "success", false,
                    "error", "Protocole non trouvé"
                ));
            }

            ProtocolSubmission protocol = protocolOpt.get();
            boolean isComplete = checkProtocolCompleteness(protocol);
            
            Map<String, Object> checklistResult = Map.of(
                "protocolId", id,
                "isComplete", isComplete,
                "missingItems", getMissingItems(protocol),
                "completionPercentage", getCompletionPercentage(protocol),
                "lastChecked", LocalDateTime.now().format(DateTimeFormatter.ISO_LOCAL_DATE_TIME)
            );

            return ResponseEntity.ok(Map.of(
                "success", true,
                "checklist", checklistResult,
                "message", isComplete ? "Dossier complet" : "Dossier incomplet - vérifiez les éléments manquants"
            ));

        } catch (Exception e) {
            logger.error("Erreur lors de la vérification de la checklist pour le protocole {}: {}", id, e.getMessage());
            return ResponseEntity.status(500).body(Map.of(
                "success", false,
                "error", "Erreur lors de la vérification"
            ));
        }
    }

    private java.util.List<String> getMissingItems(ProtocolSubmission protocol) {
        java.util.List<String> missing = new java.util.ArrayList<>();
        
        if (protocol.getTitle() == null || protocol.getTitle().trim().isEmpty()) {
            missing.add("Titre du protocole");
        }
        if (protocol.getDescription() == null || protocol.getDescription().trim().isEmpty()) {
            missing.add("Description du protocole");
        }
        if (protocol.getPrincipalInvestigator() == null || protocol.getPrincipalInvestigator().trim().isEmpty()) {
            missing.add("Chercheur principal");
        }
        if (protocol.getInstitution() == null || protocol.getInstitution().trim().isEmpty()) {
            missing.add("Institution");
        }
        if (protocol.getParticipants() == null || protocol.getParticipants() <= 0) {
            missing.add("Nombre de participants");
        }
        if (protocol.getDuration() == null || protocol.getDuration() <= 0) {
            missing.add("Durée de l'étude");
        }
        if (protocol.getEthicalConsiderations() == null || protocol.getEthicalConsiderations().trim().isEmpty()) {
            missing.add("Considérations éthiques");
        }
        if (protocol.getProtocolFileName() == null || protocol.getProtocolFileName().trim().isEmpty()) {
            missing.add("Fichier protocole");
        }
        if (protocol.getConsentFormFileName() == null || protocol.getConsentFormFileName().trim().isEmpty()) {
            missing.add("Formulaire de consentement");
        }
        if (protocol.getCvFilesNames() == null || protocol.getCvFilesNames().trim().isEmpty()) {
            missing.add("CV des chercheurs");
        }
        if (protocol.getPaymentReceiptFileName() == null || protocol.getPaymentReceiptFileName().trim().isEmpty()) {
            missing.add("Reçu de paiement");
        }
        if (protocol.getPresidentLetterFileName() == null || protocol.getPresidentLetterFileName().trim().isEmpty()) {
            missing.add("Lettre adressée au Président du Comité");
        }
        if (protocol.getInformationNoticeFileName() == null || protocol.getInformationNoticeFileName().trim().isEmpty()) {
            missing.add("Notice d'information");
        }
        if (protocol.getInformedConsentFileName() == null || protocol.getInformedConsentFileName().trim().isEmpty()) {
            missing.add("Consentement éclairé");
        }
        if (protocol.getChronogramFileName() == null || protocol.getChronogramFileName().trim().isEmpty()) {
            missing.add("Chronogramme");
        }
        if (protocol.getDetailedBudgetFileName() == null || protocol.getDetailedBudgetFileName().trim().isEmpty()) {
            missing.add("Budget détaillé en Franc CFA");
        }
        
        return missing;
    }

    private int getCompletionPercentage(ProtocolSubmission protocol) {
        int totalItems = 16; // Nombre total d'éléments à vérifier (11 + 5 nouveaux)
        int completedItems = totalItems - getMissingItems(protocol).size();
        return Math.round((float) completedItems * 100 / totalItems);
    }
}
