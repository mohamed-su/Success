# Configuration Base de Données
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password

# Configuration Email
MAIL_USERNAME=your_email@domain.com
MAIL_PASSWORD=your_app_specific_password

# Configuration JWT (IMPORTANT: Générer une clé sécurisée)
JWT_SECRET=generate_a_secure_random_key_at_least_256_bits_long
JWT_ACCESS_VALIDITY=15
JWT_REFRESH_VALIDITY=7

# Configuration Application
BASE_URL=http://localhost:8081
UPLOAD_DIR=uploads

# Configuration Environnement
SPRING_PROFILES_ACTIVE=dev

# INSTRUCTIONS DE SÉCURITÉ:
# 1. Copiez ce fichier vers .env
# 2. Remplacez toutes les valeurs par vos vraies valeurs
# 3. Générez une clé JWT sécurisée avec: openssl rand -base64 32
# 4. Ne commitez JAMAIS le fichier .env dans Git
# 5. Utilisez des mots de passe forts et uniques